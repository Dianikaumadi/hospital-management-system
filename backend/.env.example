NODE_ENV=development
PORT=4000
# Neon: copy the pooled connection string from Neon > Connect > Node.js
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/hospital_management?sslmode=require
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
# Invitation links are valid for this many hours.
INVITATION_EXPIRES_HOURS=72

# SMTP settings for automatic staff invitation emails.
# Example Gmail setup: use an app password, not your normal account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="CarePoint <your-email@gmail.com>"

# Requests per 15 minutes per IP. Default: 300 when NODE_ENV=production, effectively unlimited otherwise.
# RATE_LIMIT_MAX=300
