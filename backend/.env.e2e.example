# Backend environment used ONLY when running the E2E suite against a Neon branch.
# Copy to backend/.env.e2e (already git-ignored) and fill in your branch's connection string.
# Start the backend with this file instead of the real .env - see e2e/README.md "Using a Neon branch".

NODE_ENV=development
PORT=4000

# The pooled connection string of a Neon branch created specifically for testing (Neon console:
# select the branch > Connect > Node.js). Never point this at the same branch a real deployment or
# your own development session uses - the suite creates an Admin account and test data here, and
# sweeps rows matching e2e-* / *@hms-e2e.test at the end of every run.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/hospital_management?sslmode=require
DATABASE_SSL=true

JWT_SECRET=any-random-string-for-local-e2e-runs
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173

# Left blank on purpose: the invitation-onboarding tests call the real email-sending code path, and
# a configured SMTP_HOST here would send real email to fabricated @hms-e2e.test addresses.
# SMTP_HOST=
# EMAIL_FROM=

# The default limit (300/15min in production) is fine to leave unset - development mode already
# runs with an effectively unlimited rate limit.
