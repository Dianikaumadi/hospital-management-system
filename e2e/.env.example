# --- Application under test -------------------------------------------------
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:4000

# --- Test accounts ----------------------------------------------------------
# Accounts are created automatically by global-setup (POST /api/auth/register) or
# reused if they already exist. Password must be >= 8 characters.
E2E_USER_PASSWORD=E2eTest#2026
E2E_EMAIL_DOMAIN=hms-e2e.test

# --- Servers ----------------------------------------------------------------
# true  -> Playwright starts backend + frontend itself (needs the backend env, see README)
# false -> servers must already be running (default locally)
E2E_START_SERVERS=false

# --- Test data cleanup (optional) --------------------------------------------
# The API has no DELETE endpoints, so cleanup talks to PostgreSQL directly.
# Point this at the SAME database the backend uses. Leave empty to skip cleanup.
E2E_DATABASE_URL=
E2E_DATABASE_SSL=false
# Safety switch: the suite (setup + cleanup) refuses to run against a non-local database unless this is true.
E2E_ALLOW_REMOTE_DB=false
# end  -> sweep all e2e-* test data once after the run (default, safest for parallel runs)
# test -> additionally delete each test's data in afterEach (breaks @counts monotonic checks
#         if dashboards tests run in parallel - use --workers=1)
# off  -> never delete anything
E2E_CLEANUP=end
