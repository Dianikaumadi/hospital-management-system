# --- Application under test -------------------------------------------------
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:4000

# --- Test accounts ----------------------------------------------------------
# Accounts are created automatically by global-setup, or reused if they already exist.
# POST /api/auth/register is admin-only (no anonymous sign-up), so the very first Admin account is
# seeded directly in the database instead - set E2E_DATABASE_URL below for that to work on an empty
# database. The other five role accounts are then registered through the API with the admin's token.
# Password must be >= 8 characters.
E2E_USER_PASSWORD=E2eTest#2026
E2E_EMAIL_DOMAIN=hms-e2e.test

# --- Servers ----------------------------------------------------------------
# true  -> Playwright starts backend + frontend itself (needs the backend env, see README)
# false -> servers must already be running (default locally)
#
# Whichever way the backend starts, if it loads backend/.env and that file has real SMTP_HOST /
# EMAIL_FROM credentials configured, the invitation tests here WILL send real emails through them
# (to fabricated @hms-e2e.test addresses). Blank SMTP_HOST for that backend process before running
# this suite locally - see "Safety" in README.md. CI is unaffected (it never loads backend/.env).
E2E_START_SERVERS=false

# --- Database (required on a fresh DB, optional afterwards) -----------------
# Needed the first time you run against an empty database, to seed the initial Admin account
# directly (see above). Also enables cleanup: the API has no DELETE endpoints, so cleanup talks to
# PostgreSQL directly. Point this at the SAME database the backend uses - and make sure that is a
# DISPOSABLE database (local Postgres or a dedicated test branch), never a real/shared one.
# See "Safety" in README.md - this must not be the same value as backend/.env's DATABASE_URL unless
# that one is already disposable.
E2E_DATABASE_URL=
E2E_DATABASE_SSL=false
# Safety switch: the suite (setup + cleanup) refuses to run against a non-local database unless this is true.
E2E_ALLOW_REMOTE_DB=false
# end  -> sweep all e2e-* test data once after the run (default, safest for parallel runs)
# test -> additionally delete each test's data in afterEach (breaks @counts monotonic checks
#         if dashboards tests run in parallel - use --workers=1)
# off  -> never delete anything
E2E_CLEANUP=end
