{
  "name": "hospital-management-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end test suite for the Hospital Management System",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright show-report reports/html",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --grep @api",
    "test:failed": "playwright test --last-failed",
    "codegen": "playwright codegen http://localhost:5173",
    "cleanup": "tsx scripts/cleanup.ts",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.8.1",
    "@types/pg": "^8.11.10",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
